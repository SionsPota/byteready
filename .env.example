# =============================================================================
# .env.example - 环境变量模板
# 复制为 .env 后填入真实值，切勿将 .env 提交到 GitHub
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Kimi LLM (Moonshot AI) - 主对话模型
# 用于：文本对话、代码生成、推理等
# ---------------------------------------------------------------------------
KIMI_API_KEY=sk-kimi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-k2.6

# ---------------------------------------------------------------------------
# 2. 硅基流动 (SiliconFlow) - 生图 + Embedding + Rerank
# 注册地址：https://cloud.siliconflow.cn/
# API Key 获取：https://cloud.siliconflow.cn/account/ak
# ---------------------------------------------------------------------------

# 通用配置（生图、Embedding、Rerank 共用）
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 生图模型：Tongyi-MAI/Z-Image-Turbo（阿里通义万相）
# 模型页面：https://cloud.siliconflow.cn/me/models?target=Tongyi-MAI%2FZ-Image-Turbo
SILICONFLOW_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo

# Embedding 模型：用于 RAG 文本向量化
# 推荐：BAAI/bge-large-zh-v1.5（中文效果好）
# 备选：BAAI/bge-m3（多语言，性能更强）
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Rerank 模型：用于 RAG 召回结果精排序
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------------------------------------------------------------------------
# 3. 火山引擎 (Volcengine) - TTS + ASR（豆包系列）
# 注册地址：https://www.volcengine.com/
# 新版控制台 API Key 获取：https://console.volcengine.com/speech/service/8
# ---------------------------------------------------------------------------

# 火山引擎新版控制台 API Key（TTS 和 ASR 共用）
VOLCENGINE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# TTS 语音合成配置
# 资源 ID：seed-tts-2.0 (TTS 2.0 字符版) / seed-tts-1.0 (TTS 1.0 字符版) / seed-tts-1.0-concurr (TTS 1.0 并发版)
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SPEAKER=zh_female_shuangkuaisisi_moon_bigtts
VOLCENGINE_TTS_AUDIO_FORMAT=mp3
VOLCENGINE_TTS_SAMPLE_RATE=24000
VOLCENGINE_TTS_SPEECH_RATE=0
VOLCENGINE_TTS_LOUDNESS_RATE=0

# ASR 语音识别配置
# 资源 ID：volc.seedasr.sauc.duration (ASR 2.0 小时版) / volc.seedasr.sauc.concurrent (ASR 2.0 并发版)
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_LANGUAGE=zh-CN
VOLCENGINE_ASR_FORMAT=wav
VOLCENGINE_ASR_SAMPLE_RATE=16000

# ---------------------------------------------------------------------------
# 4. 服务器部署配置（购买服务器后填写）
# ---------------------------------------------------------------------------
SERVER_HOST=your-server-public-ip
SERVER_PORT=8000

# ---------------------------------------------------------------------------
# 5. 可选：其他服务配置
# ---------------------------------------------------------------------------

# Redis（如需缓存/消息队列）
# REDIS_URL=redis://localhost:6379/0

# 数据库（如需持久化存储）
# DATABASE_URL=sqlite:///./app.db

# 日志级别
# LOG_LEVEL=INFO
