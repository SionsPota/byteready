{
  "name": "@byteready/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "node --disable-warning=ExperimentalWarning src/scripts/seed-demo.ts",
    "replay:demo": "node --disable-warning=ExperimentalWarning src/scripts/replay-demo.ts",
    "replay:demo:interactive": "node --disable-warning=ExperimentalWarning src/scripts/replay-demo-interactive.ts",
    "interactive:demo": "node --disable-warning=ExperimentalWarning src/scripts/interactive-demo.ts",
    "auto:replay:all": "node --disable-warning=ExperimentalWarning src/scripts/auto-replay-all.ts",
    "cleanup:demo": "node --disable-warning=ExperimentalWarning src/scripts/cleanup-demo-sessions.ts"
  },
  "dependencies": {
    "@byteready/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "mammoth": "^1.12.0",
    "openai": "^6.0.0",
    "pdfjs-dist": "^5.7.284",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
